#---------------------------------------------------------------------
# Perform initialisation
#---------------------------------------------------------------------
MyCmd=$(whence   $0)
MyDir=$(dirname  ${MyCmd})
MyCmd=$(basename $0)
MyArgs="$*"
PATH=${PATH}:${MyDir}
export PATH
MyRc=0
export WEBSPHERE_LOG=${WEBSPHERE_LOG:=/var/log/websphere/${MyCmd}.$(date "+%Y_%m_%d_%H_%M_%S").log}

WAS_HOME={{ was_profile }}
#---------------------------------------------------------------------
# Next line set the websphere application server - APP_SERVER
#---------------------------------------------------------------------
APP_SERVER={{ server_name }}
DATE=$(date +%d/%m/%y)

echo;echo
echo "Logging of shutdown in ${WEBSPHERE_LOG}"
echo;echo

echo "---------------------------------------------------"  >> ${WEBSPHERE_LOG}
echo "- START -- shutdown on $(date "+%Y-%m-%d %T")      -"  >> ${WEBSPHERE_LOG}
echo "---------------------------------------------------"  >> ${WEBSPHERE_LOG}

#---------------------------------------------------------------------
# Display start-up message in the system log
#---------------------------------------------------------------------
#alogecho "Stopping ${MyDir}/${MyCmd} ${MyArgs}" >> ${SYSMAN_ALOG}
echo "################################################################" >> ${WEBSPHERE_LOG}
echo "# Stopping ${MyDir}/${MyCmd} ${MyArgs}"                           >> ${WEBSPHERE_LOG}
echo "################################################################" >> ${WEBSPHERE_LOG}

#---------------------------------------------------------------------
# On exit display termination message into system log.
#---------------------------------------------------------------------
trap "terminate;" 0
function terminate
{
  echo "Completed ${MyDir}/${MyCmd}, RC=${MyRc}\n\n"
}

trap "murder;" 1 2 3 15
function murder
{
  MyRc=255
  echo "${MyDir}/${MyCmd} is being murdered!!!" 1>&2
  exit ${MyRc}
}

#---------------------------------------------------------------------
# Ensure NO parameters other than those expected have been passed
#---------------------------------------------------------------------
if [ $# -ne 0 ]; then
  echo "Invalid number of parameters supplied $#, none expected!!!"
  MyRc=16
  exit ${MyRc}
fi

#---------------------------------------------------------------------
# Start the application
#---------------------------------------------------------------------
echo "Stopping WebSphere Application Server."

rm -f ${WAS_HOME}/bin/nohup.out
(( MyRc = MyRc + $? ))
su - webadmn -c "nohup ${WAS_HOME}/bin/stopServer.sh ${APP_SERVER}" >> ${WEBSPHERE_LOG}
(( MyRc = MyRc + $? ))

echo "WebSphere shutdown complete" >> ${WEBSPHERE_LOG}

