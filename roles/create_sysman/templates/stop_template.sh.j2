echo "- END ---- shutdown on   $(date "+%Y-%m-%d %T")    -"  >> ${WEBSPHERE_LOG}
echo "---------------------------------------------------"  >> ${WEBSPHERE_LOG}

cat ${WEBSPHERE_LOG}

exit ${MyRc}




