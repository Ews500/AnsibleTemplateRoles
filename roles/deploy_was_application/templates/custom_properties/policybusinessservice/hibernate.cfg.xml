<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE hibernate-configuration PUBLIC
          "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
          "http://hibernate.sourceforge.net/hibernate-configuration-3.0.dtd">

<!-- Generated by MyEclipse Hibernate Tools.                   -->
<hibernate-configuration>

	<session-factory>

		<!--The following properties are used when making a remote connection -->
		<property name="hibernate.connection.datasource">{{ env_vars.jdbc_datasource_list | json_query('[?db_name==`%s`].jndi_name' | format(vault[app].sym_db_name)) | join(" ") }}</property>
		<property name="hibernate.jndi.url">iiop://localhost:{{ env_vars.was_bootstrap_port }}</property>
		<property name="hibernate.jndi.class">com.ibm.websphere.naming.WsnInitialContextFactory</property>

		<property name="dialect">org.hibernate.dialect.OracleDialect</property>

		<!-- JDBC connection pool (use the built-in) -->
		<property name="connection.pool_size">1</property>

		<!-- Disable the second-level cache  -->
		<property name="cache.provider_class">org.hibernate.cache.NoCacheProvider</property>

		<!-- Echo all executed SQL to stdout -->
		<property name="show_sql">false</property>

		<!-- Drop and re-create the database schema on startup -->
		<property name="hbm2ddl.auto"></property>

		<!-- Include all of the mapping here -->
		<mapping resource="com/atradius/createpolicy/dataaccess/hibernate/mapping/TborCustomerDetails.hbm.xml" />
		<mapping resource="com/atradius/createpolicy/dataaccess/hibernate/mapping/TbbuCreditLimits.hbm.xml" />
		<mapping resource="com/atradius/createpolicy/dataaccess/hibernate/mapping/TborNonNcmOrganisations.hbm.xml" />
		<mapping resource="com/atradius/createpolicy/dataaccess/hibernate/mapping/TbpoRefProductModuleTypes.hbm.xml" />
		<mapping resource="com/atradius/createpolicy/dataaccess/hibernate/mapping/TbseApplicationErrorDecods.hbm.xml" />
		<mapping resource="com/atradius/createpolicy/dataaccess/hibernate/mapping/TborOrganisationDetails.hbm.xml" />
		<mapping resource="com/atradius/createpolicy/dataaccess/hibernate/mapping/TbbuPolicies.hbm.xml" />
		<mapping resource="com/atradius/createpolicy/dataaccess/hibernate/mapping/TborFinancialData.hbm.xml" />
		<mapping resource="com/atradius/createpolicy/dataaccess/hibernate/mapping/TbseIndivSecurityGroups.hbm.xml" />
		<mapping resource="com/atradius/createpolicy/dataaccess/hibernate/mapping/TborPolModVariables.hbm.xml" />
		<mapping resource="com/atradius/createpolicy/dataaccess/hibernate/mapping/TborSystemUsers.hbm.xml" />
		<mapping resource="com/atradius/createpolicy/dataaccess/hibernate/mapping/TborOrgOtherSysRef.hbm.xml" />
		<mapping resource="com/atradius/createpolicy/dataaccess/hibernate/mapping/TborBuyerDetails.hbm.xml" />
		<mapping resource="com/atradius/createpolicy/dataaccess/hibernate/mapping/TbbuTradeSectors.hbm.xml" />
		<mapping resource="com/atradius/createpolicy/dataaccess/hibernate/mapping/TbpoDeclarationPeriods.hbm.xml" />
		<mapping resource="com/atradius/createpolicy/dataaccess/hibernate/mapping/TbpoExtWpDeviation.hbm.xml" />
		<mapping resource="com/atradius/createpolicy/dataaccess/hibernate/mapping/TbpoPolDets.hbm.xml" />
		<mapping resource="com/atradius/createpolicy/dataaccess/hibernate/mapping/TborCountries.hbm.xml" />

	</session-factory>
</hibernate-configuration>
