<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
"-//Hibernate/Hibernate Configuration DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-configuration-3.0.dtd">

<!-- Generated by MyEclipse Hibernate Tools.                   -->
<hibernate-configuration>

        <session-factory>

                <!--    The following properties are used when making a remote connection -->

                <property name="connection.datasource">{{ env_vars.jdbc_datasource_list | json_query('[?db_name==`%s`].jndi_name' | format(vault[app].sym_db_name)) | join(" ") }}</property>
                <property name="hibernate.jndi.url">iiop://localhost:{{ env_vars.was_bootstrap_port }}</property>
                <property name="hibernate.jndi.class">com.ibm.websphere.naming.WsnInitialContextFactory</property>
                <property name="dialect">org.hibernate.dialect.Oracle10gDialect</property>

                <!-- User name/password -->

                <!-- JDBC connection pool (use the built-in) -->
		<property name="connection.pool_size">0</property>

                <!-- Disable the second-level cache  -->
                <property name="cache.provider_class">
                        org.hibernate.cache.NoCacheProvider
                </property>

                <!-- Echo all executed SQL to stdout -->
                <property name="show_sql">false</property>

                <property name="hibernate.format_sql">true</property>
                <property name="hibernate.use_sql_comments">true</property>

                <property name="hbm2ddl.auto"></property>
        </session-factory>
</hibernate-configuration>
