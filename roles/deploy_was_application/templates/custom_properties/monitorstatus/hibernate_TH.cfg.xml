<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
"-//Hibernate/Hibernate Configuration DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-configuration-3.0.dtd">
<!-- Added by INPPAT3 for auto Synchronisation Gap -->
<hibernate-configuration>
<session-factory>
    <property name="hibernate.jndi.url">iiop://localhost:{{ env_vars.was_bootstrap_port }}</property>
    <property name="hibernate.jndi.class">com.ibm.websphere.naming.WsnInitialContextFactory</property>
    <property name="connection.datasource">{{ env_vars.jdbc_datasource_list | json_query('[?db_name==`%s`].jndi_name' | format(vault[app].thd_db_name)) | join(" ") }}</property>
    <property name="hibernate.connection.driver_class">oracle.jdbc.driver.OracleDriver</property>
    <property name="dialect">com.atradius.dao.AtradiusDialect</property>
    <property name="connection.pool_size">1</property>
	<property name="cache.provider_class">org.hibernate.cache.NoCacheProvider</property>
    <property name="show_sql">false</property>
    <property name="hibernate.format_sql">true</property>
    <property name="hibernate.use_sql_comments">true</property>
    <property name="hbm2ddl.auto"></property>
</session-factory>
</hibernate-configuration>
