#

#
# Host Alias section
#
ResourceType=VirtualHost
ImplementingResourceType=VirtualHost
ResourceId=Cell=!{cellName}:VirtualHost={{ virtual_host.name }}
AttributeInfo=aliases(port,hostname)
#

#
# Properties
#
{% for port in virtual_host.ports %}
{{ port.port_value }}={!{hostName}} # {{ port.desc }}
{% endfor %}


EnvironmentVariablesSection

# Environment Variables
cellName={{ env_vars.cell_name }}
hostName=*
